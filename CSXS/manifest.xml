<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.jmgphotography.ultrastudio" ExtensionBundleVersion="1.3.0"
    ExtensionBundleName="JMG Ultra Studio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.jmgphotography.ultrastudio.panel" Version="1.3.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.jmgphotography.ultrastudio.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--enable-experimental-web-platform-features</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>JMG Ultra Studio</Menu>
          <Geometry>
            <Size><Height>820</Height><Width>460</Width></Size>
            <MinSize><Height>360</Height><Width>320</Width></MinSize>
            <MaxSize><Height>4000</Height><Width>2400</Width></MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./assets/icon-dark.png</Icon>
            <Icon Type="RollOver">./assets/icon-dark.png</Icon>
            <Icon Type="DarkNormal">./assets/icon-dark.png</Icon>
            <Icon Type="DarkRollOver">./assets/icon-dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
